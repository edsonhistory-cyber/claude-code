[
 {
  "id": "L1",
  "text": "Tonight, the old night train makes its last run.",
  "voice": "bm_george",
  "speed": 0.78
 },
 {
  "id": "L2a",
  "text": "From the snow,",
  "voice": "bm_george",
  "speed": 0.78
 },
 {
  "id": "L2b",
  "text": "all the way down to the sea.",
  "voice": "bm_george",
  "speed": 0.78
 },
 {
  "id": "L3a",
  "text": "For forty years,",
  "voice": "bm_george",
  "speed": 0.78
 },
 {
  "id": "L3b",
  "text": "it stopped at every small station on the line.",
  "voice": "bm_george",
  "speed": 0.78
 },
 {
  "id": "L4",
  "text": "Then came the long tunnel.",
  "voice": "bm_george",
  "speed": 0.78
 },
 {
  "id": "L5a",
  "text": "On the other side, the snow was gone,",
  "voice": "bm_george",
  "speed": 0.78
 },
 {
  "id": "L5b",
  "text": "and the river towns kept their lights on for it.",
  "voice": "bm_george",
  "speed": 0.78
 },
 {
  "id": "L6",
  "text": "At the end of the line, the ocean was waiting.",
  "voice": "bm_george",
  "speed": 0.78
 },
 {
  "id": "L7",
  "text": "One by one, the windows went dark.",
  "voice": "bm_george",
  "speed": 0.78
 },
 {
  "id": "L8",
  "text": "But the station light stays on, for the next train.",
  "voice": "bm_george",
  "speed": 0.78
 }
]