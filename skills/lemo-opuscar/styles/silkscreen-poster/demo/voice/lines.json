[
 {
  "id": "L01",
  "text": "I wanted to get as far from home as the world allows.",
  "voice": "bf_emma",
  "speed": 0.58,
  "lang": "en-gb"
 },
 {
  "id": "L02",
  "text": "Day one. Beijing. Zero kilometres.",
  "voice": "bf_emma",
  "speed": 1.05,
  "lang": "en-gb",
  "asr": "day one Beijing zero kilometers"
 },
 {
  "id": "L03",
  "text": "Istanbul. Seven thousand kilometres.",
  "voice": "bf_emma",
  "speed": 1.05,
  "lang": "en-gb",
  "asr": "Istanbul 7000 kilometers"
 },
 {
  "id": "L04",
  "text": "Paris. Eight thousand two hundred. Not far enough.",
  "voice": "bf_emma",
  "speed": 0.83,
  "lang": "en-gb",
  "asr": "Paris 8200, not far enough."
 },
 {
  "id": "L05",
  "text": "Then Buenos Aires. Nineteen thousand.",
  "voice": "bf_emma",
  "speed": 1.05,
  "lang": "en-gb",
  "asr": "Then Buenos Aires, 19,000."
 },
 {
  "id": "L06",
  "text": "On a round world, that is almost as far as you can go.",
  "voice": "bf_emma",
  "speed": 0.55,
  "lang": "en-gb"
 },
 {
  "id": "L07",
  "text": "And from there, every road leads home.",
  "voice": "bf_emma",
  "speed": 0.77,
  "lang": "en-gb"
 },
 {
  "id": "L08",
  "text": "Thirty-nine thousand six hundred kilometres later,",
  "voice": "bf_emma",
  "speed": 0.99,
  "lang": "en-gb",
  "asr": "39,600 km later."
 },
 {
  "id": "L09",
  "text": "Beijing again. Zero kilometres.",
  "voice": "bf_emma",
  "speed": 1.05,
  "lang": "en-gb",
  "asr": "Beijing again, 0 km."
 },
 {
  "id": "L10",
  "text": "It turns out, the far side of the world is just the long way home.",
  "voice": "bf_emma",
  "speed": 0.58,
  "lang": "en-gb"
 }
]